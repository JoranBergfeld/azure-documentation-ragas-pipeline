FOUNDRY_PROJECT_ENDPOINT="https://<your-project>.services.ai.azure.com"
FOUNDRY_CHAT_MODEL="gpt-5.4"
FOUNDRY_EMBEDDING_MODEL="text-embedding-3-small"
# Online faithfulness gate, routed by provider (ADR-0011): a name containing
# "claude" uses the Anthropic /anthropic route; any other model (e.g. Kimi-K2.5)
# uses the OpenAI-compatible route. Must be a non-generator family (ADR-0009).
JUDGE_MODEL="Kimi-K2.5"
OFFLINE_JUDGE_MODEL="DeepSeek-V4-Pro"
# Retrieval candidate pool per leg (dense/bm25) before fusion; rerank narrows to TOP_K.
# Keep >= TOP_K + 3*MAX_RETRIES so every guardrail retry has real headroom to widen into.
CANDIDATE_POOL=15
SEARCH_ENDPOINT="https://<your-search>.search.windows.net"
SEARCH_INDEX="ms-docs"
GENERATOR_AGENT_NAME="ragpipe-generator"
GENERATOR_AGENT_VERSION="1"
FAITHFULNESS_THRESHOLD="0.7"
MAX_RETRIES="2"
TOP_K="5"
RRF_K="60"
TESTSET_MODE="handauthored"
# Set to "true" to also score context_precision/recall at each retrieval stage
# (dense/bm25/fused/reranked) in the offline eval — heavier, opt-in.
PER_STAGE_METRICS="false"
