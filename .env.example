FOUNDRY_PROJECT_ENDPOINT="https://<your-project>.services.ai.azure.com"
FOUNDRY_CHAT_MODEL="gpt-5.4"
FOUNDRY_EMBEDDING_MODEL="text-embedding-3-small"
# Online faithfulness gate, routed by provider (ADR-0011): a name containing
# "claude" uses the Anthropic /anthropic route; any other model (e.g. Kimi-K2.5)
# uses the OpenAI-compatible route. Must be a non-generator family (ADR-0009).
JUDGE_MODEL="Kimi-K2.5"
OFFLINE_JUDGE_MODEL="DeepSeek-V4-Pro"
# Model roles (ADR-0022). Every role runs on the Foundry account above unless its URL is
# set, which moves it to an OpenAI-compatible server such as vLLM on the DGX Spark. The
# URL is the server root (no /v1); a moved role needs its served model name, and gets the
# key if the server wants one. Roles: GENERATOR, PLANNER, INGEST_WRITER, EMBEDDER, JUDGE,
# OFFLINE_JUDGE, RERANKER. Keep generator and both judges in three different model
# families (a fine-tune counts as its base model's family). Move one role at a time and
# re-run the eval after each move.
# PLANNER_URL="http://192.168.5.6:8101"
# PLANNER_MODEL="<served model name>"
# PLANNER_API_KEY="<key>"
# Retrieval candidate pool per leg (dense/bm25) before fusion; rerank narrows to TOP_K.
# Keep >= TOP_K + 3*MAX_RETRIES so every guardrail retry has real headroom to widen into.
CANDIDATE_POOL=15
# Retrieval's Postgres (ADR-0021). The service uses the read-only rag_service login;
# the import (python -m ragpipe.pg_import) uses the owner, from RAG_IMPORT_DATABASE_URL.
RAG_DATABASE_URL="postgresql://rag_service:<password>@192.168.5.40:5432/rag"
# RAG_IMPORT_DATABASE_URL="postgresql://rag:<password>@192.168.5.40:5432/rag"
# Cross-encoder on the DGX Spark for contextual/baseline/raptor_sac (issue #40). Unset or
# unreachable: those three modes report reranker-offline. From the laptop, tunnel first:
# ssh -N -L 8100:127.0.0.1:8100 joran@192.168.5.6, then RERANKER_URL=http://127.0.0.1:8100
RERANKER_URL="http://192.168.5.6:8100"
RERANKER_API_KEY="<key>"
# RERANKER_MODEL="nvidia/llama-nemotron-rerank-1b-v2"
# Ingest still writes Azure AI Search until it learns Postgres.
# SEARCH_ENDPOINT="https://<your-search>.search.windows.net"
GENERATOR_AGENT_NAME="ragpipe-generator"
GENERATOR_AGENT_VERSION="1"
# Online faithfulness gate operating point. Measures GROUNDING in the retrieved
# context, not factual correctness. Fit it to human labels and pin it with
# scripts/calibrate_threshold.py rather than trusting the uncalibrated 0.7 default
# (ADR-0018); the frozen canary watches both judges for drift.
FAITHFULNESS_THRESHOLD="0.7"
MAX_RETRIES="2"
TOP_K="5"
RRF_K="60"
TESTSET_MODE="handauthored"
# Set to "true" to also score context_precision/recall at each retrieval stage
# (the active substrate's own stages, always ending in reranked) in the offline
# eval — heavier, opt-in.
PER_STAGE_METRICS="false"
